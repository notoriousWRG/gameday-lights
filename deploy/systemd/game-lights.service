# Install: copy to ~/.config/systemd/user/, adjust WorkingDirectory/ExecStart if the repo
# is not in ~/hack/game-lights, then:
#   systemctl --user daemon-reload && systemctl --user enable --now game-lights
# To keep it running when you are logged out: loginctl enable-linger $USER
[Unit]
Description=Game Lights (score-triggered bulb effects)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hack/game-lights
ExecStart=%h/hack/game-lights/.venv/bin/game-lights --config %h/hack/game-lights/config.toml run
Restart=on-failure
RestartSec=10
# SIGTERM is handled: the process stops cleanly
KillSignal=SIGTERM

[Install]
WantedBy=default.target
