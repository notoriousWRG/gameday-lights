# Install: copy to ~/.config/systemd/user/, adjust WorkingDirectory/ExecStart if the repo
# is not in ~/hack/gameday-lights, then:
#   systemctl --user daemon-reload && systemctl --user enable --now gameday-lights
# To keep it running when you are logged out: loginctl enable-linger $USER
[Unit]
Description=Gameday Lights (score-triggered bulb effects)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hack/gameday-lights
ExecStart=%h/hack/gameday-lights/.venv/bin/gameday-lights --config %h/hack/gameday-lights/config.toml run
Restart=on-failure
RestartSec=10
# SIGTERM is handled: the process stops cleanly
KillSignal=SIGTERM

[Install]
WantedBy=default.target
